# Local-only overrides, loaded by dev-server.php before .env (values here win).
APP_URL=http://127.0.0.1:8001
DB_HOST=127.0.0.1
DB_DATABASE=shop_majazi_dev
DB_USERNAME=root
DB_PASSWORD=

# Fake number providers, SMS.ir and Telegram (see DevFakeProviders in app/Helper/VirtualNumberHelper.php).
DEV_FAKE_PROVIDERS=true

# Local test accounts (shop_majazi_dev only), password secret12: 09120000001, 09120000002.

# The Next.js site (card payments come back here from the bank).
STOREFRONT_URL=http://localhost:3000
